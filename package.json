{
  "name": "symphony-node", "version": "0.1.0", "private": true, "type": "module",
  "description": "Windows-ready TypeScript implementation of the Symphony orchestration core",
  "engines": { "node": ">=22" },
  "scripts": { "build": "tsc -p tsconfig.json && node scripts/copy-web.mjs", "start": "node dist/src/cli.js", "dev": "npm run build && node dist/src/cli.js", "check": "tsc --noEmit", "test": "npm run build && node --test dist/test/*.test.js" },
  "dependencies": { "liquidjs": "^10.21.1", "yaml": "^2.8.1" },
  "devDependencies": { "@types/node": "^24.0.0", "typescript": "^5.9.2" }
}
